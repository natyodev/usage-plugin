{
  "name": "usage-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:bin && bun run build:font && bun run build:widget && bun run build:cffi",
    "build:bin": "bun build src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/usage-plugin",
    "build:font": "bun scripts/build-icon-font.ts",
    "build:widget": "bun build widget/main.ts --target=browser --format=esm --external 'gi://*' --external cairo --outfile dist/widget.js",
    "build:cffi": "mkdir -p dist && gcc -shared -fPIC -O2 -Wall -o dist/usage-plugin-cffi.so cffi/usage-cffi.c $(pkg-config --cflags --libs gtk+-3.0 gio-2.0 json-glib-1.0)",
    "pack:npm": "bun scripts/pack-npm.ts",
    "check": "tsc --noEmit && bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "svg2ttf": "6.1.0",
    "svgicons2svgfont": "16.0.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
